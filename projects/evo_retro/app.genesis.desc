# app.genesis.desc - registers the Sega Genesis emulator as a launcher tile.
# evo_retro makes two tiles from one project, so its descriptors are named
# app.<system>.desc. The binary is built by ./build.sh (it needs the emulator
# cores fetched first), so `build` is empty here; your own ROM files go in
# /fs/sda1/evo/genesis/. The launch script carries the audio library path.
name    = Genesis
exec    = genesis_launch.sh
icon    = genesis.rgba
order   = 18
enabled = 1
build   =
deploy  = bin/evo_genesis target/genesis_launch.sh
