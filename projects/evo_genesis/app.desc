# app.desc - registers the Sega Genesis emulator as a launcher tile.
# The binary and its launch script live in /fs/sda1/evo; your own ROM files go in
# /fs/sda1/evo/genesis/. The script carries the audio library path. `make` here
# builds the binary (and fetches the emulator core on the first build, see core.sh).
name    = Genesis
exec    = genesis_launch.sh
icon    = genesis.rgba
order   = 18
enabled = 1
deploy  = bin/evo_genesis target/genesis_launch.sh
