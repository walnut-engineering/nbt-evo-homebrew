+/* Alignment-safe little-end reads from a packed buffer. The direct
+   *(int*)(buf+N) / *(short*)(buf+N) casts below hit unaligned offsets (e.g.
+   buf+42) which fault on ARM/QNX (the compiler may also merge adjacent reads
+   into an alignment-requiring LDRD). memcpy carries the same bytes and the
+   compiler still folds the aligned cases to a single load. */
+static ID_INLINE short unz_rd16( const byte *p ) { short v; memcpy( &v, p, sizeof( v ) ); return v; }
+static ID_INLINE int   unz_rd32( const byte *p ) { int   v; memcpy( &v, p, sizeof( v ) ); return v; }
