+/* ARM/QNX strict alignment: the interpreter accesses the VM data segment at
+   VM-controlled addresses that are frequently unaligned (e.g. OP_LOAD4/OP_STORE4
+   at an odd game address). A direct short/int cast faults on a strict-alignment
+   target, so these memcpy accessors carry the same bytes safely. OP_BLOCK_COPY
+   already uses memcpy. gcc folds the provably-aligned cases to a single load. */
+static ID_INLINE int  VM_Load32( const byte *p ) { int32_t v; memcpy( &v, p, 4 ); return v; }
+static ID_INLINE int  VM_Load16u( const byte *p ) { unsigned short v; memcpy( &v, p, 2 ); return v; }
+static ID_INLINE void VM_Store32( byte *p, int v ) { int32_t t = v; memcpy( p, &t, 4 ); }
+static ID_INLINE void VM_Store16( byte *p, int v ) { short t = (short)v; memcpy( p, &t, 2 ); }
+
